# Скопируйте этот файл в scripts/seed-demo.env и заполните.
# Сам seed-demo.env в git не попадает (он в .gitignore).

# Адрес бэкенда без слеша в конце:
#   локально             http://localhost:3000
#   DigitalOcean         https://<ваше-приложение>.ondigitalocean.app
SEED_API_URL=http://localhost:3000

# Существующий подтверждённый пользователь с ролью ADMIN
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123

# Пароль для всех демо-тренеров и демо-клиентов.
# 8-20 символов: заглавная буква, строчная буква и цифра.
SEED_DEMO_PASSWORD=DemoPass2026
